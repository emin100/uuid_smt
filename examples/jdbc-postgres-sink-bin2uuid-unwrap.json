{
  "name": "jdbc-pg-sink-unwrap-bin2uuid",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "dbserver1.inventory.customers",
    "connection.url": "jdbc:postgresql://postgres:5432/appdb",
    "connection.username": "app",
    "connection.password": "change-me",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "database.time_zone": "UTC",
    "transforms": "unwrap,bin2uuid",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.bin2uuid.type": "io.debezium.uuid.BinaryToUuid$Value",
    "transforms.bin2uuid.fields": "id,tenant_id",
    "transforms.bin2uuid.byte.order": "RFC_4122"
  }
}
